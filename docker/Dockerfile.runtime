# syntax=docker/dockerfile:1
FROM taffy-recovery:ubuntu24.04
RUN --mount=type=secret,id=proxy_ca,mode=0444,required=true export APT_CONFIG=/tmp/apt-ca && printf 'Acquire::https::CaInfo "/run/secrets/proxy_ca";\n' > "$APT_CONFIG" && apt-get update && apt-get install -y --no-install-recommends libgl1 libegl1 libopengl0 libglib2.0-0 libxrender1 libxkbcommon-x11-0 libxcb-xinerama0 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-render-util0 libsm6 libice6 xvfb xauth && rm -rf /var/lib/apt/lists/* /tmp/apt-ca
COPY uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/python UV_PYTHON_BIN_DIR=/opt/python-bin
RUN --mount=type=secret,id=proxy_ca,mode=0444,required=true SSL_CERT_FILE=/run/secrets/proxy_ca UV_NATIVE_TLS=true uv python install 3.10 && uv venv --python 3.10 /opt/venv
RUN --mount=type=secret,id=proxy_ca,mode=0444,required=true SSL_CERT_FILE=/run/secrets/proxy_ca UV_NATIVE_TLS=true uv pip install --python /opt/venv/bin/python 'numpy==1.26.4' 'scipy==1.15.3' 'PyQt5==5.15.11' 'vtk==9.3.1' 'open3d==0.19.0' 'pytest==8.4.2'
ENV PATH=/opt/venv/bin:$PATH
WORKDIR /work
CMD ["python", "original/rootfs/opt/taffy-editor/main.pyc"]
RUN --mount=type=secret,id=proxy_ca,mode=0444,required=true export APT_CONFIG=/tmp/apt-ca && printf 'Acquire::https::CaInfo "/run/secrets/proxy_ca";\n' > "$APT_CONFIG" && apt-get update && apt-get install -y --no-install-recommends libfontconfig1 libxcb-shape0 libdbus-1-3 fonts-noto-cjk && rm -rf /var/lib/apt/lists/* /tmp/apt-ca
